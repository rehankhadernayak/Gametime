# Top-level template for local docker-compose runs.
# Backend deployment? Use backend/.env.example for the canonical list.
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=2h
DATABASE_PATH=./data/gametime.db
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8081
# Frontend (Vite) — set one of these to the Express API origin (same value is fine):
#   VITE_API_BASE_URL=http://localhost:4000
#   VITE_API_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
# Comma-separated parent emails that see “Seed demo data” and auto-enable web demo mode on login
VITE_REVIEWER_DEMO_PARENT_EMAILS=
# Google Sign-In (web): OAuth 2.0 Web client ID; must be listed in backend GOOGLE_OAUTH_CLIENT_IDS
VITE_GOOGLE_CLIENT_ID=
DATA_ENCRYPTION_KEY=replace_with_a_32+_char_secret
# Google Sign-In: comma-separated Web+iOS+Android client IDs (must include every client that mints ID tokens you accept)
GOOGLE_OAUTH_CLIENT_IDS=

# AI - Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# AI - OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Giftcards (Athena)
ATHENA_ENABLED=false
ATHENA_MOCK_MODE=true
ATHENA_BASE_URL=https://api-sandbox.athenagaming.gg
ATHENA_API_VERSION=v2
ATHENA_API_KEY=
ATHENA_PARTNER_ID=
ATHENA_GIFTCODE_SECRET=
ATHENA_WEBHOOK_SECRET=
ATHENA_TIMEOUT_MS=15000

# Email
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gametime <no-reply@gametime.local>
EMAIL_CHECK_MODE=smtp
EMAIL_ALLOW_UNKNOWN_SMTP=false
EMAIL_SMTP_PROBE_TIMEOUT_MS=5000
EMAIL_SMTP_PROBE_MAX_HOSTS=3
EMAIL_PROBE_FROM=verify@gametime.local
EMAIL_HELO_DOMAIN=gametime.local
SKIP_MX_VALIDATION=false

# Stripe (optional - GP top-up)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
