# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=2h

# ── Database ───────────────────────────────────────────────────────────
DATABASE_PATH=./data/gametime.db

# ── Encryption ─────────────────────────────────────────────────────────
# Used to encrypt gift card codes at rest (AES-256-GCM).
# IMPORTANT: set this in production and never change it — changing the key
# will make all previously encrypted gift card codes unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace_with_a_64_char_hex_string

# ── AI (Anthropic Claude) ──────────────────────────────────────────────
# Get your key at: https://console.anthropic.com → API Keys
# Without this key the app still works — it uses local rules to review
# task evidence instead of Claude Vision.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Email — Resend (recommended) ──────────────────────────────────────
# Get a free API key at https://resend.com → API Keys
# Without this, emails use Ethereal test accounts (preview only, no real delivery)
RESEND_API_KEY=
SMTP_FROM=Gametime <no-reply@yourdomain.com>

# ── Email — Legacy SMTP (alternative to Resend) ────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SKIP_MX_VALIDATION=false

# ── Giftcard API (optional — Athena Gaming) ────────────────────────────
ATHENA_ENABLED=false
ATHENA_MOCK_MODE=true
ATHENA_BASE_URL=https://api-sandbox.athenagaming.gg
ATHENA_API_VERSION=v2
ATHENA_API_KEY=
ATHENA_PARTNER_ID=
ATHENA_GIFTCODE_SECRET=
ATHENA_WEBHOOK_SECRET=
