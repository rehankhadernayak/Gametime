# =============================================================================
# Gametime Backend — Environment Variables
# Copy this file to backend/.env and fill in real values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ── Database ───────────────────────────────────────────────────────────
# Absolute path required in production (mapped via Docker volume)
DATABASE_PATH=/app/data/gametime.db

# ── Encryption ─────────────────────────────────────────────────────────
# Used to encrypt gift card codes at rest (AES-256-GCM).
# IMPORTANT: set this in production and never change it — changing the key
# will make all previously encrypted gift card codes unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For Vercel previews (unique URL per branch/PR), append: ,https://*.vercel.app
# (literal entry; backend allows any https://<sub>.vercel.app when present).
FRONTEND_ORIGIN=https://yourdomain.com

# ── AI (Anthropic Claude) ──────────────────────────────────────────────
# Get your key at: https://console.anthropic.com → API Keys
# Without this key the app still works — it uses local rules to review
# task evidence instead of Claude Vision.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── AI (OpenAI — optional fallback) ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Email — Resend (recommended) ──────────────────────────────────────
# Get a free API key at https://resend.com → API Keys
RESEND_API_KEY=
SMTP_FROM=Gametime <no-reply@yourdomain.com>

# EMAIL_CHECK_MODE: "smtp" | "resend" | "none"
EMAIL_CHECK_MODE=smtp

# ── Email — Legacy SMTP (alternative to Resend) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Advanced email probe settings (safe to leave at defaults)
EMAIL_ALLOW_UNKNOWN_SMTP=false
EMAIL_SMTP_PROBE_TIMEOUT_MS=5000
EMAIL_SMTP_PROBE_MAX_HOSTS=3
EMAIL_PROBE_FROM=verify@yourdomain.com
EMAIL_HELO_DOMAIN=yourdomain.com
SKIP_MX_VALIDATION=false

# ── Giftcard API (Athena Gaming) ───────────────────────────────────────
# Set ATHENA_ENABLED=true only when you have real API credentials
ATHENA_ENABLED=false
ATHENA_MOCK_MODE=true
ATHENA_BASE_URL=https://api.athenagaming.gg
ATHENA_API_VERSION=v2
ATHENA_API_KEY=
ATHENA_PARTNER_ID=
ATHENA_GIFTCODE_SECRET=
ATHENA_WEBHOOK_SECRET=
ATHENA_TIMEOUT_MS=15000

# ── Stripe ────────────────────────────────────────────────────────────
# Required for GP top-up payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
