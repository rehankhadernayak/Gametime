{
  "name": "gametime-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node -e \"import('./src/db/init.js').then(m => m.initDb())\"",
    "db:reset": "node src/db/reset.js",
    "db:backup": "node scripts/backup.js",
    "seed:mock-gift": "node scripts/seed-mock-reward-request.mjs",
    "test": "vitest run && node scripts/verify-cors-production.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.10.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "stripe": "^20.4.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.3",
    "vitest": "^2.1.9"
  }
}
