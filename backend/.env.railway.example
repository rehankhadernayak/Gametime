# ── Copy these into Railway → Variables ───────────────────────────────────────
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Database — Railway Volume must be mounted at /data
DATABASE_PATH=/data/gametime.db

# Auth & Encryption — generate fresh values, never reuse dev defaults
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRES_IN=7d

# Server
PORT=4000

# Frontend URL (your Railway frontend service URL or custom domain)
FRONTEND_ORIGIN=https://your-frontend.railway.app

# AI (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Email — use Resend (free tier: 3000/month)
# Sign up at resend.com, get API key, add your domain
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_YOUR_RESEND_KEY
SMTP_FROM=Gametime <hello@yourdomain.com>

# Stripe — for GP top-up (add later)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Athena giftcards — add when ready to scale
# ATHENA_ENABLED=false
