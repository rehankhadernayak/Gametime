# Canonical public URL for Open Graph, sitemap, and robots (no trailing slash). Falls back to VERCEL_URL or localhost in dev.
NEXT_PUBLIC_SITE_URL=

# Production: full backend URL (no trailing slash). Dev: leave unset to use same-origin /api (see next.config rewrites).
# If you set this to http://localhost:4000 for local dev, the app still uses /api when opened from a tunnel or non-loopback host so API calls stay same-origin.
NEXT_PUBLIC_API_URL=

# Same value as backend JWT_SECRET — required for Edge middleware to verify gametime_token (HS256).
JWT_SECRET=
