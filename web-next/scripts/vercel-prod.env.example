# Copy to vercel-prod.env (do not commit) and fill values, then run:
#   VERCEL_TOKEN=... ./scripts/vercel-deploy-prod.sh
#
# ALB_HTTP_URL can be left empty if Terraform state exists or ALB_NAME resolves via AWS CLI.

ALB_HTTP_URL=
# Optional if ALB_HTTP_URL is empty: default gametime-prod-alb (see infra/aws/terraform/alb.tf)
# ALB_NAME=gametime-prod-alb

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
JWT_SECRET=

# Optional: stable canonical URL for OG / sitemap (no trailing slash). If unset, Vercel sets VERCEL_URL at runtime.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
