# Copy to web-next/.env.deployment (gitignored) and fill in real values from Railway + Supabase + Vercel.
# Run: node scripts/push-vercel-production.mjs

# Vercel: https://vercel.com/account/tokens — export as VERCEL_TOKEN for CI
VERCEL_TOKEN=

# Optional: Vercel team slug or id (vercel link --scope). Omit for personal account.
# VERCEL_SCOPE=

# Vercel project name (default gametime-web)
VERCEL_PROJECT=gametime-web

# Railway public API origin (no trailing slash) — Agent 21
API_PROXY_TARGET=https://your-service.up.railway.app
NEXT_PUBLIC_API_URL=https://your-service.up.railway.app

# Supabase — Agent 19
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Must match backend JWT_SECRET on Railway exactly
JWT_SECRET=

# Optional: canonical site URL for OG/sitemap (usually your Vercel production URL)
# NEXT_PUBLIC_SITE_URL=https://gametime-web.vercel.app

# Set to 1 to curl /api/ai/chat after deploy (expects 401 without Bearer)
VERIFY_AI_PROXY=1
